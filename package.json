{
  "name": "botprogracraft",
  "version": "0.1.0",
  "private": true,
  "description": "BotPrograCraft — AI Pair-Programming & Socratic Tutor monorepo with Gemini Live API, IDE bridge, and Electron HUD.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:shared": "npm run build --workspace=@botprogracraft/shared"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
