# Google Gemini API Key (required for @botprogracraft/ai-core Live API)
GEMINI_API_KEY=your_gemini_api_key_here

# Local WebSocket bridge port between IDE extension and Desktop HUD
BOTPROGRACRAFT_WS_PORT=4848

# Optional default tutor mode: socratic | pair-programming | explain-bug | logic-challenge
BOTPROGRACRAFT_TUTOR_MODE=socratic
