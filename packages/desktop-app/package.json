{
  "name": "@botprogracraft/desktop-app",
  "version": "0.2.0",
  "author": "BotPrograCraft",
  "private": true,
  "description": "Electron + React floating HUD overlay for BotPrograCraft.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "dev": "vite",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@botprogracraft/ai-core": "*",
    "@botprogracraft/shared": "*",
    "@botprogracraft/storage": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.botprogracraft.desktop",
    "productName": "BotPrograCraft",
    "electronVersion": "35.7.5",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "../../assets/icon.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    }
  }
}
